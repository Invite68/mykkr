# ══════════════════════════════════════════════════════════
# My KKR — Environment Variables Template
# ══════════════════════════════════════════════════════════
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env.local
#   2. Fill in real values in .env.local
#   3. NEVER commit .env.local to git
#   4. For production: add all values to Coolify → Environment Variables
# ══════════════════════════════════════════════════════════

# ── App ──
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (PostgreSQL — self-hosted on Coolify) ──
# Coolify auto-injects DATABASE_URL if you link the PostgreSQL service.
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME
# After deploying run:  psql "$DATABASE_URL" -f migrations/001_jobs.sql
DATABASE_URL=postgresql://mykkr_user:REPLACE_WITH_PASSWORD@localhost:5432/mykkr_db

# Optional: set to "true" if your Postgres requires SSL (Coolify internal network: false)
DATABASE_SSL=false

# ── Encryption (AES-256-GCM for phone numbers stored in jobs table) ──
# SERVER SIDE ONLY — never prefix with NEXT_PUBLIC_
# Generate:  openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# ── SSE Stream Token (short-lived HMAC tokens for /api/jobs/stream auth) ──
# SERVER SIDE ONLY — never prefix with NEXT_PUBLIC_
# EventSource API cannot send Authorization headers; we use a signed query param instead.
# Generate:  openssl rand -base64 48
STREAM_TOKEN_SECRET=REPLACE_WITH_48_CHAR_RANDOM_SECRET

# ── Firebase (Phone OTP Auth) ──
# Get from: Firebase Console → Project Settings → Your Apps
# NEXT_PUBLIC_ variables are visible in the browser — OK for Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_YOUR_PROJECT.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_APP_ID

# ── Firebase Admin (SERVER SIDE ONLY — never use NEXT_PUBLIC_ prefix) ──
FIREBASE_ADMIN_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID
FIREBASE_ADMIN_PRIVATE_KEY=REPLACE_WITH_PRIVATE_KEY_FROM_SERVICE_ACCOUNT_JSON
FIREBASE_ADMIN_CLIENT_EMAIL=REPLACE_WITH_CLIENT_EMAIL_FROM_SERVICE_ACCOUNT_JSON

# ── JWT ──
# Generate:  openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Razorpay ──
# Get from: dashboard.razorpay.com → Settings → API Keys
# Test keys start with rzp_test_, live keys with rzp_live_
NEXT_PUBLIC_RAZORPAY_KEY_ID=REPLACE_WITH_rzp_test_OR_rzp_live_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_SECRET_NEVER_EXPOSE_THIS
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET_FROM_RAZORPAY_DASHBOARD

# ── Telegram (Rider notifications) ──
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_RIDERS_CHAT_ID=REPLACE_WITH_GROUP_CHAT_ID

# ── n8n (internal automation) ──
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

# ── Email ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_YOUR_EMAIL
SMTP_PASS=REPLACE_WITH_APP_PASSWORD

# ── Rate Limiting ──
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_TTL=600

# ── Google Maps (optional — defaults to free OpenStreetMap) ──
GOOGLE_MAPS_API_KEY=
